# Copy to .env (git-ignored) and set LLM_API_KEY. Without a key, retrieval still runs and the train
# outputs replay from the committed LLM cache; new questions need a key.

# Defaults are the setup the committed outputs were made with: Groq's free tier
# (https://console.groq.com/keys), one model per role. Leave the rest blank to use them.
LLM_API_KEY=

# Another OpenAI-compatible provider: set LLM_BASE_URL and LLM_MODEL; LLM_MODEL then serves every role.
# LLM_BACKEND=claude-cli uses a local Claude Code CLI instead (no key; roles default to haiku).
LLM_BACKEND=openai
LLM_BASE_URL=
LLM_MODEL=

# Optional per-role overrides (query planning, reranking, action planning). On free tiers each model
# has its own daily quota, so splitting roles across models multiplies the budget.
LLM_MODEL_PLAN=
LLM_MODEL_RERANK=
LLM_MODEL_ACT=

# Optional: speech-to-text model for `make voice` (same endpoint and key), and a microphone name filter.
CANDOR_STT_MODEL=
CANDOR_MIC=
