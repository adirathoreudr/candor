# Copy to .env (git-ignored) and fill in. Retrieval runs without any of this;
# answers, reranking and actions need one LLM backend.

# Backend: "openai" (any OpenAI-compatible endpoint) or "claude-cli" (local Claude Code CLI, no key).
LLM_BACKEND=openai

# OpenAI-compatible endpoint, e.g. NVIDIA NIM: https://integrate.api.nvidia.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional: a different model per role (query planning, reranking). On free tiers each model has its
# own daily quota. Unset = LLM_MODEL does everything.
LLM_MODEL_PLAN=
LLM_MODEL_RERANK=
